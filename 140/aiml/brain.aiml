<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">
  <category>
    <pattern>HELLO</pattern>
    <template>Hello! I am Nova, your AIML assistant. What can I help you with?</template>
  </category>
  <category>
    <pattern>HI</pattern>
    <template>Hi there. I am ready when you are.</template>
  </category>
  <category>
    <pattern>HOW ARE YOU</pattern>
    <template>All systems are calm and ready. Thanks for asking.</template>
  </category>
  <category>
    <pattern>WHAT IS YOUR NAME</pattern>
    <template>I am Nova, a small assistant powered by AIML.</template>
  </category>
  <category>
    <pattern>WHAT CAN YOU DO</pattern>
    <template>I can chat, tell you the time and date, do safe arithmetic, and learn new replies from my AIML file.</template>
  </category>
  <category>
    <pattern>WHAT TIME IS IT</pattern>
    <template>The current time is {TIME}.</template>
  </category>
  <category>
    <pattern>WHAT IS THE DATE</pattern>
    <template>Today is {DATE}.</template>
  </category>
  <category>
    <pattern>CALCULATE *</pattern>
    <template>{CALC}</template>
  </category>
  <category>
    <pattern>THANK YOU</pattern>
    <template>You are welcome.</template>
  </category>
  <category>
    <pattern>BYE</pattern>
    <template>Goodbye. I will be here when you need me.</template>
  </category>
</aiml>
